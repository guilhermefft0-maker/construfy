{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://construpro-worker.guilhermefft0.workers.dev/api/:path*"
    },
    {
      "source": "/((?!api/|.*\\.html$).*)",
      "destination": "/index.html"
    }
  ]
}